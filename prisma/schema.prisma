// CVLab AI — Prisma schema (Phase 0 foundation)
//
// Source of truth: docs/architecture/database-overview.md, cv-data-model.md,
// credit-architecture.md, payment-architecture.md, ai-architecture.md.
//
// Timestamp convention (documented deviation from the blanket "every table has
// created_at/updated_at" rule in prompts/04-database-rules.md — see the Phase 0
// completion report for the explicit conflict callout):
//   - Entities with a mutable lifecycle get both createdAt and updatedAt.
//   - Entities that are strictly append-only / write-once (credit_transactions,
//     cv_versions, history_events, audit_logs, test_answers, interview_questions,
//     ai_requests) get only the timestamp(s) that entity's own doc section
//     specifies — adding an updatedAt to a row that is contractually never
//     updated would misleadingly imply mutability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (closed value sets explicitly defined in the architecture docs)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED

  @@map("user_status")
}

enum CvStatus {
  DRAFT
  PUBLISHED

  @@map("cv_status")
}

enum CreditTransactionType {
  PURCHASE
  BONUS
  CONSUMPTION
  REFUND
  ADMIN_ADJUSTMENT
  EXPIRATION
  PROMOTION
  REVERSAL

  @@map("credit_transaction_type")
}

/// Only MPESA exists in MVP. Future providers (EMOLA, CARD, ...) are added
/// here only when actually implemented, per docs/architecture/payment-architecture.md.
enum PaymentProviderName {
  MPESA

  @@map("payment_provider_name")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REVERSED
  REFUNDED

  @@map("payment_status")
}

enum AiRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  TIMEOUT

  @@map("ai_request_status")
}

// Phase 7 — Resume Optimization (docs/architecture/resume-optimization.md)
enum OptimizationStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("optimization_status")
}

enum SuggestionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("suggestion_priority")
}

enum SuggestionType {
  KEYWORD
  SUMMARY
  EXPERIENCE
  SKILL
  EDUCATION
  PROJECT
  ACHIEVEMENT
  LANGUAGE
  CERTIFICATION
  GENERAL

  @@map("suggestion_type")
}

// Phase 8 — Cover Letter Engine (docs/architecture/cover-letter-engine.md)
enum CoverLetterStatus {
  DRAFT
  GENERATED
  EDITED
  ARCHIVED

  @@map("cover_letter_status")
}

// Phase 9 — Interview Preparation Engine (docs/architecture/interview-engine.md)
enum InterviewType {
  GENERAL
  TECHNICAL
  BEHAVIORAL
  MIXED

  @@map("interview_type")
}

enum InterviewDifficulty {
  JUNIOR
  MID
  SENIOR
  EXECUTIVE

  @@map("interview_difficulty")
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED

  @@map("interview_status")
}

// Phase 10.5 — "Interview generation must no longer depend exclusively on
// Resume Variant. Resume becomes optional." See docs/architecture/interview-engine.md
// §"Three Modes".
enum InterviewMode {
  RESUME
  JOB
  ROLE

  @@map("interview_mode")
}

enum QuestionCategory {
  BEHAVIORAL
  TECHNICAL
  SITUATIONAL
  CULTURE
  LEADERSHIP
  COMMUNICATION

  @@map("question_category")
}

enum CoverLetterTone {
  PROFESSIONAL
  MODERN
  EXECUTIVE
  TECHNICAL
  FRIENDLY

  @@map("cover_letter_tone")
}

enum JobTargetStatus {
  DRAFT
  READY
  ARCHIVED
  // Phase 10.5 — set by JobImportService when the Job Import Engine's
  // overall extraction confidence falls below the configured threshold;
  // the frontend surfaces this alongside JobImportMetadata.fieldConfidence
  // so the user can review/correct low-confidence fields before treating
  // the auto-created JobTarget as READY.
  REQUIRES_REVIEW

  @@map("job_target_status")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  ARCHIVED

  @@map("application_status")
}

/// Phase 10.5 Resume Version History — the brief's exact label examples,
/// plus CUSTOM as the escape hatch (paired with
/// ResumeVariantVersion.customLabel free text).
enum ResumeVersionLabel {
  INITIAL
  AI_OPTIMIZED
  MANUAL_EDIT
  INTERVIEW_VERSION
  APPLICATION_VERSION
  CUSTOM

  @@map("resume_version_label")
}

/// "AI or User generated" (Resume Version History timeline requirement).
enum ResumeVersionSource {
  USER
  AI

  @@map("resume_version_source")
}

/// Export Engine (docs/architecture/export-engine.md) — the only 2 formats
/// this phase implements. DOCX/CoverLetter/ApplicationPackage formats are
/// intentionally out of scope; the model is designed so adding a value here
/// later needs no other schema change.
enum ExportFormat {
  PDF
  DOCX

  @@map("export_format")
}

/// Mirrors AiRequestStatus's PENDING→terminal shape (the closest existing
/// precedent for "a paid, potentially-failing operation with an
/// idempotency key"), even though Export never goes through
/// AiOrchestrationService.
enum ExportStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("export_status")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING_VERIFICATION)
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  profile                      Profile?
  masterResume                 MasterResume?
  jobTargets                   JobTarget[]
  applications                 Application[]
  resumeVariants               ResumeVariant[]
  createdResumeVersions        ResumeVariantVersion[]
  atsReports                   AtsReport[]
  resumeOptimizations          ResumeOptimization[]
  coverLetters                 CoverLetter[]
  interviewSessions            InterviewSession[]
  careerAdvices                CareerAdvice[]
  linkedInProfiles             LinkedInProfile[]
  cvImports                    CvImport[]
  applicationPipelineSessions  ApplicationPipelineSession[]
  exportedDocuments            ExportedDocument[]
  resumeTemplateFavorites      ResumeTemplateFavorite[]
  coverLetterTemplateFavorites CoverLetterTemplateFavorite[]
  cvs                          Cv[]
  wallet                       CreditWallet?
  creditTransactions           CreditTransaction[]
  payments                     Payment[]
  aiRequests                   AiRequest[]
  testSessions                 TestSession[]
  notifications                Notification[]
  historyEvents                HistoryEvent[]
  adminProfile                 AdminUser?
  auditLogsAsActor             AuditLog[]
  sessions                     Session[]
  verificationTokens           VerificationToken[]
  passwordResetTokens          PasswordResetToken[]

  // Soft-delete-aware uniqueness (users, profiles, cvs, tests, questions —
  // see docs/architecture/database-overview.md §3) requires PARTIAL unique
  // indexes ("WHERE deleted_at IS NULL"), which Prisma's schema language
  // cannot express directly. These are added as a hand-written follow-up
  // migration (see prisma/migrations/.../migration.sql) rather than invented
  // here as plain @@unique, which would incorrectly block reusing an email
  // after a soft-deleted account.
  @@map("users")
}

/// Personal information only — never professional/career data (that's
/// MasterResume + its sections, below). Phase 2A replaces the earlier
/// generic `content: Json` placeholder from Phase 0 with explicit columns
/// now that the concrete field list is known; no Profile rows existed yet
/// (no Phase 0/1 module ever wrote to this table), so this is additive in
/// practice even though it's a structural change to the table.
model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  displayName String?   @map("display_name")
  headline    String?
  phone       String?
  email       String?
  country     String?
  city        String?
  address     String?
  birthDate   DateTime? @map("birth_date") @db.Date
  linkedin    String?
  github      String?
  portfolio   String?
  website     String?
  // Stores a URL/reference into object storage (Cloudflare R2, Phase 5),
  // never the binary image itself — named `photoUrl` rather than the
  // brief's literal `photo` for that reason.
  photoUrl    String?   @map("photo_url")
  bio         String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Resume Engine (Phase 2A) — docs/architecture/master-resume-data-model.md
//
// The platform's professional-data source of truth is the Master Resume:
// exactly one per user, holding all career information via normalized
// section entities below. This supersedes the Phase 0 assumption that
// `cvs`/`cv_versions` (JSONB) would be the primary professional-data store;
// those tables remain in the schema, untouched and unused so far (no rows
// exist), reserved for a later phase where a "CV" becomes a filtered/
// exported view generated FROM the master resume — see the data-model doc
// for the full reconciliation.
// ---------------------------------------------------------------------------

model MasterResume {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  title                String?
  summary              String?
  careerLevel          String?  @map("career_level")
  yearsExperience      Int?     @map("years_experience")
  desiredPosition      String?  @map("desired_position")
  desiredSalary        Decimal? @map("desired_salary") @db.Decimal(12, 2)
  currency             String   @default("MZN")
  // Open string, not a closed enum — visibility semantics (PRIVATE/PUBLIC/
  // UNLISTED/...) aren't specified yet; defaulting to the safest option.
  visibility           String   @default("PRIVATE")
  // Recomputed server-side on every mutation to this resume or its
  // sections — see MasterResumeService/completion.util.ts. Never accepted
  // as client input.
  completionPercentage Int      @default(0) @map("completion_percentage")
  status               String   @default("DRAFT")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  workExperiences      WorkExperience[]
  educations           Education[]
  skills               Skill[]
  languages            Language[]
  certificates         Certificate[]
  projects             Project[]
  courses              Course[]
  awards               Award[]
  publications         Publication[]
  volunteerExperiences VolunteerExperience[]
  references           Reference[]
  resumeVariants       ResumeVariant[]
  cvImports            CvImport[]

  @@map("master_resumes")
}

model WorkExperience {
  id               String    @id @default(uuid())
  resumeId         String    @map("resume_id")
  company          String
  position         String
  employmentType   String?   @map("employment_type")
  location         String?
  country          String?
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  currentlyWorking Boolean   @default(false) @map("currently_working")
  description      String?
  achievements     String[]
  technologies     String[]
  displayOrder     Int       @default(0) @map("display_order")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("work_experiences")
}

model Education {
  id           String    @id @default(uuid())
  resumeId     String    @map("resume_id")
  institution  String
  degree       String?
  field        String?
  location     String?
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("educations")
}

model Skill {
  id              String    @id @default(uuid())
  resumeId        String    @map("resume_id")
  name            String
  category        String?
  level           String?
  yearsExperience Int?      @map("years_experience")
  displayOrder    Int       @default(0) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("skills")
}

model Language {
  id           String    @id @default(uuid())
  resumeId     String    @map("resume_id")
  language     String
  proficiency  String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("languages")
}

model Certificate {
  id             String    @id @default(uuid())
  resumeId       String    @map("resume_id")
  title          String
  issuer         String?
  issueDate      DateTime? @map("issue_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
  credentialId   String?   @map("credential_id")
  credentialUrl  String?   @map("credential_url")
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("certificates")
}

model Project {
  id           String    @id @default(uuid())
  resumeId     String    @map("resume_id")
  title        String
  description  String?
  url          String?
  technologies String[]
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("projects")
}

model Course {
  id             String    @id @default(uuid())
  resumeId       String    @map("resume_id")
  title          String
  provider       String?
  hours          Int?
  completionDate DateTime? @map("completion_date") @db.Date
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("courses")
}

/// Field list not specified in the Phase 2A brief (only listed as a section
/// name) — using the standard, minimal fields for this well-known CV
/// section type, consistent in shape with the adjacent Certificate section.
model Award {
  id           String    @id @default(uuid())
  resumeId     String    @map("resume_id")
  title        String
  issuer       String?
  dateAwarded  DateTime? @map("date_awarded") @db.Date
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("awards")
}

/// Field list not specified in the Phase 2A brief — see Award above for the
/// same rationale.
model Publication {
  id              String    @id @default(uuid())
  resumeId        String    @map("resume_id")
  title           String
  publisher       String?
  publicationDate DateTime? @map("publication_date") @db.Date
  url             String?
  description     String?
  displayOrder    Int       @default(0) @map("display_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("publications")
}

/// Field list not specified in the Phase 2A brief — mirrors WorkExperience's
/// shape (organization/role/dates/description), the closest analogous
/// section type.
model VolunteerExperience {
  id                    String    @id @default(uuid())
  resumeId              String    @map("resume_id")
  organization          String
  role                  String?
  startDate             DateTime? @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  currentlyVolunteering Boolean   @default(false) @map("currently_volunteering")
  description           String?
  displayOrder          Int       @default(0) @map("display_order")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("volunteer_experiences")
}

model Reference {
  id           String    @id @default(uuid())
  resumeId     String    @map("resume_id")
  name         String
  position     String?
  company      String?
  email        String?
  phone        String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  resume MasterResume @relation(fields: [resumeId], references: [id])

  @@index([resumeId])
  @@map("references")
}

// ---------------------------------------------------------------------------
// Job Target Engine (Phase 2B) — docs/architecture/master-resume-data-model.md §8
//
// A Job Target is a specific job opportunity the user is preparing for. It
// sits between the Master Resume and everything AI-driven that will consume
// it later (ATS analysis, resume optimization, cover letters, interview
// prep): User -> Master Resume -> Job Target -> Resume Variant (future) ->
// AI Optimization -> Application Tracking. This phase implements no AI —
// job_target_analysis exists so a future AI phase has a ready table to
// write into, and JobTargetAnalysisService's stub methods exist only to
// stabilize that future interface (see the service file).
// ---------------------------------------------------------------------------

model JobTarget {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  title          String
  company        String?
  location       String?
  employmentType String?         @map("employment_type")
  seniority      String?
  salaryMin      Decimal?        @map("salary_min") @db.Decimal(12, 2)
  salaryMax      Decimal?        @map("salary_max") @db.Decimal(12, 2)
  currency       String          @default("MZN")
  // Originally "never scraped, fetched, or parsed by the platform" (Phase
  // 2B) — superseded by the Phase 10.5 Job Import Engine: when jobUrl is
  // set via POST /job-import instead of typed manually, JobImportService
  // *does* fetch and parse it, and records that provenance in the
  // JobImportMetadata row (see docs/architecture/job-import.md). Manually
  // created JobTargets still just store jobUrl as entered, untouched.
  jobUrl         String?         @map("job_url")
  // Pasted vacancy text, or (Phase 10.5) the Job Import Engine's cleaned
  // extracted description — see JobImportMetadata.cleanedDescription for
  // the same text plus its provenance/confidence.
  jobDescription String?         @map("job_description")
  source         String?
  status         JobTargetStatus @default(DRAFT)
  notes          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                        User                         @relation(fields: [userId], references: [id])
  keywords                    JobTargetKeyword[]
  skills                      JobTargetSkill[]
  languages                   JobTargetLanguage[]
  analysis                    JobTargetAnalysis?
  importMetadata              JobImportMetadata?
  applications                Application[]
  resumeVariants              ResumeVariant[]
  atsReports                  AtsReport[]
  resumeOptimizations         ResumeOptimization[]
  coverLetters                CoverLetter[]
  interviewSessions           InterviewSession[]
  applicationPipelineSessions ApplicationPipelineSession[]
  resumeVariantVersions       ResumeVariantVersion[]

  @@index([userId])
  @@map("job_targets")
}

model JobTargetKeyword {
  id          String   @id @default(uuid())
  jobTargetId String   @map("job_target_id")
  keyword     String
  weight      Int?
  createdAt   DateTime @default(now()) @map("created_at")

  jobTarget JobTarget @relation(fields: [jobTargetId], references: [id])

  @@index([jobTargetId])
  @@map("job_target_keywords")
}

model JobTargetSkill {
  id          String   @id @default(uuid())
  jobTargetId String   @map("job_target_id")
  skill       String
  required    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  jobTarget JobTarget @relation(fields: [jobTargetId], references: [id])

  @@index([jobTargetId])
  @@map("job_target_skills")
}

model JobTargetLanguage {
  id          String   @id @default(uuid())
  jobTargetId String   @map("job_target_id")
  language    String
  level       String?
  createdAt   DateTime @default(now()) @map("created_at")

  jobTarget JobTarget @relation(fields: [jobTargetId], references: [id])

  @@index([jobTargetId])
  @@map("job_target_languages")
}

/// Phase 10.5 — one row per JobTarget created via POST /job-import
/// (JobImportService), holding the fetch/extraction audit trail the brief
/// requires: original HTML, cleaned description, per-field confidence, and
/// when the extraction ran. JobTargets created manually (the Phase 2B flow)
/// have no row here. Deliberately NOT soft-deleted — it's a point-in-time
/// audit record of one import event, not a mutable resource of its own;
/// deleting the JobTarget cascades conceptually (never physically deleted
/// by app code, matching this project's soft-delete-by-default rule for
/// every OTHER row, but see docs/architecture/job-import.md for why this
/// one table is the disclosed exception — an import record with no
/// surviving JobTarget to explain has no product meaning to preserve).
model JobImportMetadata {
  id          String @id @default(uuid())
  jobTargetId String @unique @map("job_target_id")

  sourceUrl String @map("source_url")
  // Hostname-derived label from the parser registry, e.g. "greenhouse",
  // "lever", "linkedin", "generic" — see ParserRegistry.select().
  provider  String

  rawHtml            String  @map("raw_html")
  cleanedDescription String  @map("cleaned_description")
  // Resolved once, priority order: Open Graph image -> hiringOrganization's
  // schema.org logo -> Google's favicon service for the target's own
  // domain -> the page's own <link rel="icon">. Nullable — plenty of
  // career pages expose none of these. See
  // utils/company-logo.util.ts.
  companyLogoUrl     String? @map("company_logo_url")
  // The full ParsedJobData the parser produced — responsibilities/
  // requirements/niceToHave/benefits/skills/technologies/languages as
  // structured arrays, plus normalized seniority/employmentType/salary
  // (min/max/currency/period)/experience(min/preferred years)/education
  // level — not just the flattened cleanedDescription text. JobTarget
  // itself only gets the fields it already has columns for
  // (title/company/location/employmentType/seniority/salary/
  // jobDescription) plus its keywords/skills/languages child rows; this
  // is the source-of-truth extraction the frontend's import-preview
  // screen reads to render/highlight per-section confidence.
  extractedData      Json    @map("extracted_data")

  // Per top-level ParsedJobData field, 0-1 — same shape/spirit as
  // CvImport.fieldConfidence (Phase 10.5 CV Import Engine).
  fieldConfidence   Json  @map("field_confidence")
  overallConfidence Float @map("overall_confidence")

  extractedAt DateTime @map("extracted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Set when this row's extraction data was copied from a prior import of
  // the exact same sourceUrl rather than freshly fetched/parsed (rule 13,
  // "duplicate detection" — see JobImportService.importFromUrl). Points at
  // the JobImportMetadata row the data actually came from; extractedAt
  // above still reflects the ORIGINAL extraction time, not when this row
  // was created, so the audit trail stays honest about data freshness.
  duplicateOfId String?             @map("duplicate_of_id")
  duplicateOf   JobImportMetadata?  @relation("JobImportDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    JobImportMetadata[] @relation("JobImportDuplicates")

  jobTarget JobTarget @relation(fields: [jobTargetId], references: [id], onDelete: Cascade)

  @@index([sourceUrl])
  @@map("job_import_metadata")
}

/// Prepared ahead of AI implementation (Phase 6+) — no row is written by
/// this phase. One row per JobTarget, recomputed in place (not versioned,
/// not soft-deleted) whenever a future AI phase runs analysis again.
model JobTargetAnalysis {
  id              String   @id @default(uuid())
  jobTargetId     String   @unique @map("job_target_id")
  atsScore        Int?     @map("ats_score")
  keywordsMatched String[] @map("keywords_matched")
  keywordsMissing String[] @map("keywords_missing")
  experienceGap   String?  @map("experience_gap")
  educationGap    String?  @map("education_gap")
  summary         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  jobTarget JobTarget @relation(fields: [jobTargetId], references: [id])

  @@map("job_target_analysis")
}

// ---------------------------------------------------------------------------
// Resume Variants Engine (Phase 3) — docs/architecture/master-resume-data-model.md §9
//
// A Resume Variant is an independent copy of the Master Resume, optionally
// tailored for one Job Target. Creating one snapshots the Master Resume's
// own fields + all 11 sections into `content` (Json) at that instant; after
// that, editing the Master Resume never touches existing Variants and
// editing a Variant never touches the Master Resume — see the doc for why
// this is a JSONB snapshot rather than 11 more relational "variant section"
// tables (no per-section endpoints were requested; a second full CRUD
// engine would be scope well beyond "prepare, don't over-build").
// ---------------------------------------------------------------------------

model ResumeVariant {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  masterResumeId String  @map("master_resume_id")
  jobTargetId    String? @map("job_target_id")
  // Phase 10.5 Template Engine — which ResumeTemplate renders this Variant.
  // Switching templates never touches `content`: "No content duplication.
  // Template changes must be instant." Nullable so every Variant created
  // before this phase (and any created without explicitly picking one)
  // renders with the app's implicit default template.
  templateId     String? @map("template_id")
  // Phase 11 Template Engine — Part 6 "Theme Customization": user-chosen
  // color/font/spacing/margin/header/divider/icon/photo overrides layered on
  // top of the selected ResumeTemplate's own defaults at render time.
  // Presentation-only, exactly like `templateId` — never read by anything
  // that touches `content`. Nullable: no row means "use the template's
  // defaults unchanged". See docs/architecture/template-engine.md §6.
  themeOverrides Json?   @map("theme_overrides")

  title                String
  // Edit counter — bumped by every content edit (PUT/PATCH), not by
  // archive/restore. Phase 10.5 adds `versions` (below) as the real
  // version-history table this comment anticipated; `version` itself keeps
  // its original meaning (the current row's own edit count) and now also
  // doubles as the version NUMBER of the latest `ResumeVariantVersion` row.
  version              Int     @default(1)
  // Open string, not a closed enum — same rationale as MasterResume.status.
  status               String  @default("DRAFT")
  // Distinct from soft-delete: archived = hidden-but-still-active,
  // deletedAt = removed. Archive/Restore toggle this; Delete sets deletedAt.
  archived             Boolean @default(false)
  // Recomputed server-side on create/duplicate/content-edit — never
  // accepted as client input. See ResumeVariantService.
  completionPercentage Int     @map("completion_percentage")
  content              Json

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                        User                         @relation(fields: [userId], references: [id])
  masterResume                MasterResume                 @relation(fields: [masterResumeId], references: [id])
  jobTarget                   JobTarget?                   @relation(fields: [jobTargetId], references: [id])
  template                    ResumeTemplate?              @relation(fields: [templateId], references: [id])
  applications                Application[]
  atsReports                  AtsReport[]
  resumeOptimizations         ResumeOptimization[]
  coverLetters                CoverLetter[]
  interviewSessions           InterviewSession[]
  versions                    ResumeVariantVersion[]
  applicationPipelineSessions ApplicationPipelineSession[]
  exportedDocuments           ExportedDocument[]

  @@index([userId])
  @@index([masterResumeId])
  @@index([jobTargetId])
  @@index([templateId])
  @@map("resume_variants")
}

/// Phase 10.5 Resume Version History — full version history for
/// ResumeVariant.content, per the brief: "Every Resume Variant must have
/// full version history. Users should never lose edits." A snapshot row is
/// created on every content-changing save (manual PUT edits, "Save
/// Version" checkpoints, auto-snapshots before Resume Optimization/ATS
/// analysis/Cover Letter generation/Interview preparation, applied AI
/// suggestions, restores, and Application submissions) — see
/// docs/architecture/resume-version-history.md. Append-only, like
/// AtsReport: no update method, ever.
model ResumeVariantVersion {
  id              String @id @default(uuid())
  resumeVariantId String @map("resume_variant_id")
  // Matches ResumeVariant.version at the moment this snapshot was taken —
  // human-meaningful ("version 3"), not just an opaque row id.
  versionNumber   Int    @map("version_number")
  content         Json

  label       ResumeVersionLabel  @default(MANUAL_EDIT)
  // Free text, used (not required) when label is CUSTOM, or as extra
  // detail alongside any other label.
  customLabel String?             @map("custom_label")
  source      ResumeVersionSource @default(USER)

  // Who performed the action that produced this version — always a real
  // user (even AI-sourced versions were triggered by a user action); no
  // system/service-account rows exist in this schema.
  createdByUserId String @map("created_by_user_id")

  // Point-in-time correlation — which JobTarget/CoverLetter this version
  // was associated with when captured, not necessarily what the LIVE
  // ResumeVariant references today.
  jobTargetId   String? @map("job_target_id")
  coverLetterId String? @map("cover_letter_id")

  // User-entered free text for manual checkpoints ("Save Version").
  notes         String?
  // System-generated context ("Snapshot before Resume Optimization",
  // "Restored from version 3"), shown in the timeline. Never required.
  changeSummary String? @map("change_summary")

  createdAt DateTime @default(now()) @map("created_at")

  resumeVariant     ResumeVariant      @relation(fields: [resumeVariantId], references: [id])
  createdBy         User               @relation(fields: [createdByUserId], references: [id])
  jobTarget         JobTarget?         @relation(fields: [jobTargetId], references: [id])
  coverLetter       CoverLetter?       @relation(fields: [coverLetterId], references: [id])
  applications      Application[]
  exportedDocuments ExportedDocument[]

  @@unique([resumeVariantId, versionNumber])
  @@index([resumeVariantId])
  @@map("resume_variant_versions")
}

/// Export Engine (docs/architecture/export-engine.md) — one row per export
/// attempt, the audit/idempotency record for a file generated and streamed
/// directly in the HTTP response, never persisted to storage (no
/// storageKey/storageUrl by design this phase). Mirrors AiRequest's
/// PENDING→SUCCESS/FAILED + creditsCharged/creditsRefunded shape — the
/// closest existing precedent for "a paid, potentially-failing operation
/// with an idempotency key" — even though Export never goes through
/// AiOrchestrationService (no AI call is involved; credits are charged via
/// CreditService directly).
model ExportedDocument {
  id     String @id @default(uuid())
  userId String @map("user_id")

  resumeVariantId        String  @map("resume_variant_id")
  // Set only when the caller explicitly pinned a historical version — null
  // means "whatever was current on ResumeVariant at export time".
  resumeVariantVersionId String? @map("resume_variant_version_id")

  format ExportFormat
  status ExportStatus @default(PENDING)

  // Known upfront (PDF=10, DOCX=5) and written at spend() time.
  creditsCharged  Int @default(0) @map("credits_charged")
  // Written by RefundService when spendAndExecute() auto-refunds this
  // export's charge after a render failure.
  creditsRefunded Int @default(0) @map("credits_refunded")

  // Deterministic — never includes randomUUID() — see
  // docs/architecture/export-engine.md §"Idempotency".
  idempotencyKey String  @unique @map("idempotency_key")
  failureReason  String? @map("failure_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user                 User                  @relation(fields: [userId], references: [id])
  resumeVariant        ResumeVariant         @relation(fields: [resumeVariantId], references: [id])
  resumeVariantVersion ResumeVariantVersion? @relation(fields: [resumeVariantVersionId], references: [id])

  @@index([userId])
  @@index([resumeVariantId])
  @@map("exported_documents")
}

/// One application for one Job Target. `resumeVariantId` is nullable — an
/// application can exist before a tailored variant has been created for it.
model Application {
  id                     String            @id @default(uuid())
  userId                 String            @map("user_id")
  jobTargetId            String            @map("job_target_id")
  resumeVariantId        String?           @map("resume_variant_id")
  // Phase 10.5 — "Every job application must permanently reference the
  // exact Resume Version used." Set once at creation (a fresh
  // APPLICATION_VERSION snapshot is taken at that moment, guaranteeing an
  // exact-content capture regardless of whether the live Variant has
  // already been edited since) and never changed afterward — a factual
  // record of what was submitted, not a live pointer to the Variant's
  // current state (which `resumeVariantId` above already provides).
  resumeVariantVersionId String?           @map("resume_variant_version_id")
  status                 ApplicationStatus @default(SAVED)
  appliedAt              DateTime?         @map("applied_at")
  interviewDate          DateTime?         @map("interview_date")
  result                 String?
  notes                  String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                 User                  @relation(fields: [userId], references: [id])
  jobTarget            JobTarget             @relation(fields: [jobTargetId], references: [id])
  resumeVariant        ResumeVariant?        @relation(fields: [resumeVariantId], references: [id])
  resumeVariantVersion ResumeVariantVersion? @relation(fields: [resumeVariantVersionId], references: [id])

  @@index([userId])
  @@index([jobTargetId])
  @@index([resumeVariantId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// ATS Analysis Engine (Phase 4) — docs/architecture/module-boundaries.md
//
// Fully deterministic, rule-based comparison of one Resume Variant against
// its linked Job Target — no AI/OpenAI involved anywhere in this table or
// the service that writes to it. "Never overwrite reports. Always create a
// new one." (brief, verbatim) makes this an append-only-by-convention log,
// one row per POST /ats/run call — closer in spirit to `ai_requests` than
// to a soft-deletable entity. DELETE /ats/reports/:id is therefore a real,
// physical delete (no deleted_at column) — a disclosed, deliberate
// resolution of the brief's explicit field list (no deletedAt requested)
// against the project's general soft-delete rule: an ATS report is a
// disposable, freely re-runnable computed analysis, not source-of-truth
// user data, so permanently removing one carries none of the data-loss risk
// the soft-delete rule exists to prevent.
// ---------------------------------------------------------------------------

model AtsReport {
  id              String @id @default(uuid())
  userId          String @map("user_id")
  resumeVariantId String @map("resume_variant_id")
  jobTargetId     String @map("job_target_id")

  overallScore    Int @map("overall_score")
  keywordScore    Int @map("keyword_score")
  skillsScore     Int @map("skills_score")
  experienceScore Int @map("experience_score")
  educationScore  Int @map("education_score")
  languageScore   Int @map("language_score")
  formattingScore Int @map("formatting_score")
  completionScore Int @map("completion_score")

  matchedKeywords   String[] @map("matched_keywords")
  missingKeywords   String[] @map("missing_keywords")
  recommendedSkills String[] @map("recommended_skills")
  recommendations   String[]

  createdAt DateTime @default(now()) @map("created_at")
  // Present per the brief's explicit field list; in practice always equal
  // to createdAt — no repository method ever updates a report in place
  // ("never overwrite ... always create a new one").
  updatedAt DateTime @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  resumeVariant       ResumeVariant        @relation(fields: [resumeVariantId], references: [id])
  jobTarget           JobTarget            @relation(fields: [jobTargetId], references: [id])
  resumeOptimizations ResumeOptimization[]

  @@index([userId])
  @@index([resumeVariantId])
  @@index([jobTargetId])
  @@map("ats_reports")
}

model AdminUser {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  permissions       Json?
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaMethod         String?   @map("mfa_method")
  lastAdminActionAt DateTime? @map("last_admin_action_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Authentication (Phase 1) — docs/architecture/security-architecture.md §1.1
// ---------------------------------------------------------------------------

/// One row per issued refresh token (not per login). Rotation creates a new
/// row in the same `familyId` chain and revokes the row it replaces; the
/// row is never mutated back to valid. Reuse of an already-revoked row
/// revokes every row sharing its `familyId` (compromise response).
/// `refreshTokenHash` stores an HMAC-SHA256 digest (keyed by
/// JWT_REFRESH_SECRET) of the opaque random token delivered to the client —
/// never the raw token itself.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  metadata         Json?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Email verification tokens. `tokenHash` stores an HMAC-SHA256 digest of
/// the opaque token emailed to the user — never the raw token.
model VerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("verification_tokens")
}

/// Password reset tokens. Same hashing approach as VerificationToken.
/// Successful consumption also revokes all of the user's active sessions
/// (see AuthService.resetPassword) — a password reset should end every
/// existing login, per standard security practice.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// CVs (structured JSONB document model — docs/architecture/cv-data-model.md)
// ---------------------------------------------------------------------------

model Cv {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  title            String
  templateId       String?   @map("template_id")
  currentVersionId String?   @unique @map("current_version_id")
  status           CvStatus  @default(DRAFT)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user           User        @relation(fields: [userId], references: [id])
  versions       CvVersion[] @relation("CvVersions")
  currentVersion CvVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([userId])
  @@map("cvs")
}

model CvVersion {
  id            String   @id @default(uuid())
  cvId          String   @map("cv_id")
  versionNumber Int      @map("version_number")
  schemaVersion Int      @default(1) @map("schema_version")
  content       Json
  createdBy     String?  @map("created_by")
  changeSummary String?  @map("change_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  cv           Cv  @relation("CvVersions", fields: [cvId], references: [id])
  currentForCv Cv? @relation("CurrentVersion")

  @@unique([cvId, versionNumber])
  @@map("cv_versions")
}

// ---------------------------------------------------------------------------
// Credits (docs/architecture/credit-architecture.md)
// ---------------------------------------------------------------------------

model CreditWallet {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  availableCredits  Int      @default(0) @map("available_credits")
  lifetimePurchased Int      @default(0) @map("lifetime_credits_purchased")
  lifetimeConsumed  Int      @default(0) @map("lifetime_credits_consumed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_wallets")
}

/// Append-only ledger — the system of record. Never updated or deleted.
model CreditTransaction {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  amount         Int
  type           CreditTransactionType
  balanceBefore  Int                   @map("balance_before")
  balanceAfter   Int                   @map("balance_after")
  // Loose, polymorphic pointer (e.g. a payment id or ai_request id) — never a
  // hard FK, since it can reference different tables depending on `type`.
  reference      String?
  description    String?
  actor          String?
  metadata       Json?
  idempotencyKey String                @unique @map("idempotency_key")
  createdAt      DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model CreditPackage {
  id           String   @id @default(uuid())
  priceMt      Decimal  @map("price_mt") @db.Decimal(10, 2)
  baseCredits  Int      @map("base_credits")
  bonusCredits Int      @default(0) @map("bonus_credits")
  totalCredits Int      @map("total_credits")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@map("credit_packages")
}

model FeaturePricing {
  id         String   @id @default(uuid())
  featureKey String   @unique @map("feature_key")
  cost       Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("feature_pricing")
}

// ---------------------------------------------------------------------------
// Payments (docs/architecture/payment-architecture.md)
// ---------------------------------------------------------------------------

model Payment {
  id                String              @id @default(uuid())
  userId            String              @map("user_id")
  packageId         String              @map("package_id")
  provider          PaymentProviderName
  providerReference String?             @map("provider_reference")
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("MZN")
  status            PaymentStatus       @default(PENDING)
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  completedAt       DateTime?           @map("completed_at")
  // Payments & Credits phase, Decision 2 — explicit, auditable expiration
  // for a PENDING payment (prompts/12-mpesa-integration.md §16). Set at
  // creation time; a background/on-read check compares against `now()` to
  // treat a stale PENDING payment as EXPIRED — never silently, and never
  // by deriving it implicitly from `createdAt` alone.
  expiresAt         DateTime?           @map("expires_at")

  user    User          @relation(fields: [userId], references: [id])
  package CreditPackage @relation(fields: [packageId], references: [id])

  // NULLs are distinct in Postgres unique indexes, so multiple PENDING
  // payments without a provider reference yet can coexist; only once a
  // provider reference is set does a duplicate become impossible.
  @@unique([provider, providerReference])
  @@index([userId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// AI (docs/architecture/ai-architecture.md)
// ---------------------------------------------------------------------------

model AiRequest {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  feature         String
  status          AiRequestStatus @default(PENDING)
  // Open string, not a closed enum — future providers (OpenAI, Anthropic,
  // Gemini, local LLMs) per docs/product/competitive-advantages.md's
  // "Extensible Architecture" — no closed value set specified yet, same
  // rationale as MasterResume.status.
  provider        String?
  model           String?
  requestId       String?         @map("request_id")
  inputTokens     Int?            @map("input_tokens")
  outputTokens    Int?            @map("output_tokens")
  totalTokens     Int?            @map("total_tokens")
  estimatedCost   Decimal?        @map("estimated_cost") @db.Decimal(10, 4)
  creditsCharged  Int             @default(0) @map("credits_charged")
  // Set by RefundService when a spendAndExecute() call auto-refunds this
  // request's charge after a platform-caused failure. See credits module.
  creditsRefunded Int             @default(0) @map("credits_refunded")
  durationMs      Int?            @map("duration_ms")
  // SHA-256 hex digest of the prompt text — never the raw prompt itself,
  // per docs/architecture/ai-architecture.md §5 ("never full raw prompts by
  // default"). Lets a future phase dedupe/cache by identical prompt without
  // storing user content.
  promptHash      String?         @map("prompt_hash")
  // Version of the PromptBuilder/PromptTemplate that produced promptHash —
  // see docs/architecture/ai-orchestration.md §"Prompt Engine". Lets
  // analytics/debugging distinguish "same feature, different prompt
  // revision" without needing the raw prompt text.
  promptVersion   Int?            @map("prompt_version")
  errorCode       String?         @map("error_code")
  metadata        Json?
  // Required by docs/architecture/database-overview.md §4 (idempotency-critical
  // constraints) even though not enumerated in ai-architecture.md §4's field
  // list — added here to satisfy the explicit unique-constraint requirement.
  idempotencyKey  String          @unique @map("idempotency_key")
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([feature, createdAt])
  @@index([status])
  @@map("ai_requests")
}

// ---------------------------------------------------------------------------
// Resume Optimization (docs/architecture/resume-optimization.md, Phase 7)
// ---------------------------------------------------------------------------

model ResumeOptimization {
  id              String @id @default(uuid())
  userId          String @map("user_id")
  resumeVariantId String @map("resume_variant_id")
  jobTargetId     String @map("job_target_id")
  // The "before" AtsReport this optimization was run against — either an
  // existing report reused, or a fresh one run just-in-time (see
  // ResumeOptimizationService.run() / the `force` input flag).
  atsReportId     String @map("ats_report_id")

  status         OptimizationStatus @default(PENDING)
  // Snapshot of what CreditService.spendAndExecute() actually charged —
  // never recomputed from feature_pricing after the fact, so historical rows
  // stay accurate even if pricing changes later.
  creditsUsed    Int                @default(0) @map("credits_used")
  beforeScore    Int                @map("before_score")
  // AI-estimated score if every suggestion were accepted — not re-measured
  // until a real ATS re-run happens (see apply()).
  predictedScore Int?               @map("predicted_score")
  summary        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user              User                     @relation(fields: [userId], references: [id])
  resumeVariant     ResumeVariant            @relation(fields: [resumeVariantId], references: [id])
  jobTarget         JobTarget                @relation(fields: [jobTargetId], references: [id])
  atsReport         AtsReport                @relation(fields: [atsReportId], references: [id])
  suggestions       OptimizationSuggestion[]
  coverLetters      CoverLetter[]
  interviewSessions InterviewSession[]

  @@index([userId])
  @@index([resumeVariantId])
  @@map("resume_optimizations")
}

model OptimizationSuggestion {
  id             String @id @default(uuid())
  optimizationId String @map("optimization_id")

  type          SuggestionType
  // Which of the 8 sections ResumeSuggestionApplier knows how to write to
  // (summary/experience/skills/projects/education/languages/certifications/
  // achievements) — a plain string, not a closed enum, since the AI response
  // supplies it and an unrecognized value must be safely skippable at apply
  // time rather than fail Prisma validation at parse time.
  section       String
  title         String
  description   String?
  reason        String?
  priority      SuggestionPriority @default(MEDIUM)
  // Empty string (never null) when a suggestion is a pure addition with no
  // existing text to replace — see ResumeSuggestionApplier.
  originalText  String?            @map("original_text")
  suggestedText String             @map("suggested_text")

  // User selects which suggestions to apply (accepted); ResumeSuggestionApplier
  // then marks the ones it actually wrote to the resume variant (applied).
  // A suggestion can be accepted without being applied (e.g. its section was
  // unrecognized) — applied implies accepted, never the reverse.
  accepted     Boolean @default(false)
  applied      Boolean @default(false)
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  optimization ResumeOptimization @relation(fields: [optimizationId], references: [id])

  @@index([optimizationId])
  @@map("optimization_suggestions")
}

// ---------------------------------------------------------------------------
// Cover Letter Engine (docs/architecture/cover-letter-engine.md, Phase 8)
// ---------------------------------------------------------------------------

model CoverLetter {
  id              String  @id @default(uuid())
  userId          String  @map("user_id")
  resumeVariantId String  @map("resume_variant_id")
  jobTargetId     String  @map("job_target_id")
  // Optional link to the Resume Optimization run whose summary informed this
  // letter's prompt — see CoverLetterPromptBuilder. Never required.
  optimizationId  String? @map("optimization_id")
  // Phase 10.5 Template Engine — same "instant switch, no content
  // duplication" rule as ResumeVariant.templateId.
  templateId      String? @map("template_id")
  // Phase 11 Template Engine — same theme-override mechanism as
  // ResumeVariant.themeOverrides, see there for the full rationale.
  themeOverrides  Json?   @map("theme_overrides")

  title    String
  content  String
  tone     CoverLetterTone
  // Open string (e.g. "pt-MZ", "en"), not a closed enum — same rationale as
  // MasterResume.status: no closed value set specified by the brief.
  language String
  // "Never overwrite previous versions. Every regeneration creates a new
  // version" — regenerate() creates a brand-new row with version =
  // source.version + 1; this column is never incremented in place. Mirrors
  // the "always create a new one" precedent from AtsReport (Phase 4) rather
  // than ResumeVariant's in-place edit-counter (Phase 3) — see
  // cover-letter-engine.md §"Versioning" for why this table follows the
  // former, not the latter.
  version  Int               @default(1)
  status   CoverLetterStatus @default(DRAFT)

  // Snapshot of what CreditService.spendAndExecute() actually charged for
  // this specific row — 0 for a manually-duplicated copy, which costs
  // nothing to create.
  creditsUsed   Int     @default(0) @map("credits_used")
  generatedByAI Boolean @default(true) @map("generated_by_ai")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                  User                   @relation(fields: [userId], references: [id])
  resumeVariant         ResumeVariant          @relation(fields: [resumeVariantId], references: [id])
  jobTarget             JobTarget              @relation(fields: [jobTargetId], references: [id])
  optimization          ResumeOptimization?    @relation(fields: [optimizationId], references: [id])
  template              CoverLetterTemplate?   @relation(fields: [templateId], references: [id])
  interviewSessions     InterviewSession[]
  resumeVariantVersions ResumeVariantVersion[]

  @@index([userId])
  @@index([resumeVariantId])
  @@index([templateId])
  @@map("cover_letters")
}

// ---------------------------------------------------------------------------
// Career Advisor Engine (docs/architecture/career-advisor-engine.md, Phase 18)
// ---------------------------------------------------------------------------

model CareerAdvice {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  // The exact question asked — either one of the frontend's suggested
  // prompts or a free-text custom question. Never inferred/reconstructed.
  question String

  // The AI's structured response, split into typed columns (not one Json
  // blob) — same "explicit typed columns over blobs" convention already
  // used by CoverLetter/ResumeOptimization/AtsReport (see e.g.
  // AtsReport.missingKeywords as a native String[]).
  summary           String
  currentAssessment String   @map("current_assessment")
  strengths         String[]
  gaps              String[]
  recommendations   String[]
  nextSteps         String[] @map("next_steps")

  // Lightweight record of which optional data sources fed this advice
  // (booleans/counts only, e.g. {"hasMasterResume":true,"jobTargetsCount":2})
  // — never the resume/job target content itself, which already lives in
  // its own tables and can be read again when needed. See
  // docs/architecture/career-advisor-engine.md "Context Snapshot".
  contextSnapshot Json? @map("context_snapshot")
  // Snapshot of what CreditService.spendAndExecute() actually charged for
  // this row — same rationale as ResumeOptimization.creditsUsed: never
  // recomputed from feature_pricing after the fact.
  creditsUsed     Int   @default(0) @map("credits_used")
  // Loose pointer to the matching AiRequest row, never a FK — same style as
  // other cross-references in this schema. AiRequest itself never stores
  // the actual question/response text (only technical/billing metadata),
  // so this table is the sole place the generated content lives.
  aiRequestId     String? @map("ai_request_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@map("career_advice")
}

// ---------------------------------------------------------------------------
// LinkedIn / Professional Profile Engine (docs/architecture/linkedin-engine.md, FASE 19)
// ---------------------------------------------------------------------------

model LinkedInProfile {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  // Free-text, optional — the role the generated profile should be angled
  // toward. Never required: when absent, the prompt falls back to the most
  // recent Job Target (if any) or general optimization. Stored verbatim,
  // never inferred/reconstructed on read.
  targetRole String? @map("target_role")

  // The AI's structured response, typed columns — same convention as
  // CareerAdvice/CoverLetter/AtsReport (explicit columns over one Json blob).
  headline              String
  about                 String
  skills                String[]
  experienceSuggestions String[] @map("experience_suggestions")
  recommendations       String[]

  // Lightweight record of which optional data sources fed this generation
  // (booleans/counts only, e.g. {"hasMasterResume":true,"jobTargetsCount":1})
  // — never the resume/job target content itself, which already lives in
  // its own tables and can be read again when needed. Same rationale as
  // CareerAdvice.contextSnapshot.
  contextSnapshot Json? @map("context_snapshot")
  // Snapshot of what CreditService.spendAndExecute() actually charged for
  // this row — never recomputed from feature_pricing after the fact.
  creditsUsed     Int   @default(0) @map("credits_used")
  // Loose pointer to the matching AiRequest row, never a FK — AiRequest
  // itself never stores the actual generated text, only technical/billing
  // metadata, so this table is the sole place the generated content lives.
  aiRequestId     String? @map("ai_request_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@map("linkedin_profiles")
}

// ---------------------------------------------------------------------------
// Interview Preparation Engine (docs/architecture/interview-engine.md, Phase 9)
// ---------------------------------------------------------------------------

model InterviewSession {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Phase 10.5 — "Interview generation must no longer depend exclusively on
  // Resume Variant. Resume becomes optional." `mode` selects which of the
  // three input shapes below is authoritative; the others stay null for
  // that mode. See docs/architecture/interview-engine.md §"Three Modes".
  mode InterviewMode @default(RESUME)

  // Mode RESUME/JOB: the Variant being interviewed about. Mode ROLE: null —
  // "No Resume required." "One InterviewSession references one Resume
  // Variant" — a single FK, not a list; many sessions may reference the
  // same variant over time (each practice run is its own session), but each
  // session has exactly one.
  resumeVariantId String? @map("resume_variant_id")
  // Mode RESUME (if the Variant has one linked)/JOB: the Job Target being
  // interviewed about. Mode ROLE: null.
  jobTargetId     String? @map("job_target_id")
  // FASE 11 — Mode JOB only, pasted vacancy text supplied directly by the
  // user at start() time (independently of, or alongside, jobTargetId — see
  // §"Three Modes"). Deliberately its own column rather than reusing
  // JobTarget.jobDescription: that field belongs to a JobTarget row, and
  // Mode JOB must support "existing Job Target + supplementary free text"
  // without losing either piece, plus the free-text-only case where no
  // JobTarget exists at all. Treated as untrusted user data in the prompt,
  // never as instructions — see InterviewQuestionPromptBuilder. Null in
  // modes RESUME/ROLE.
  jobDescription  String? @map("job_description")
  // Both optional, both purely additional prompt context for question
  // generation — never required, never cross-validated against each other
  // or against resumeVariantId, mirroring Cover Letter's identical
  // optimizationId precedent (Phase 8: ownership-checked, not
  // consistency-checked). Only meaningful in modes that have a
  // resumeVariantId/jobTargetId to begin with.
  optimizationId  String? @map("optimization_id")
  coverLetterId   String? @map("cover_letter_id")

  // Mode ROLE only — free-text role title ("Backend Developer", "Civil
  // Engineer", ...), optional industry/company context, and years of
  // experience the candidate should be interviewed as if they have. All
  // null in modes RESUME/JOB.
  role            String? @map("role")
  industry        String? @map("industry")
  yearsExperience Int?    @map("years_experience")
  companyName     String? @map("company_name")

  type       InterviewType
  difficulty InterviewDifficulty
  // Open string (e.g. "en", "pt-MZ"), not a closed enum — same rationale as
  // CoverLetter.language.
  language   String

  // All four nullable — set only once by evaluate(), never before. See
  // interview-scoring.util.ts for how they're derived from per-answer scores.
  overallScore       Int? @map("overall_score")
  communicationScore Int? @map("communication_score")
  technicalScore     Int? @map("technical_score")
  confidenceScore    Int? @map("confidence_score")

  status      InterviewStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now()) @map("started_at")
  completedAt DateTime?       @map("completed_at")
  deletedAt   DateTime?       @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id])
  resumeVariant ResumeVariant?      @relation(fields: [resumeVariantId], references: [id])
  jobTarget     JobTarget?          @relation(fields: [jobTargetId], references: [id])
  optimization  ResumeOptimization? @relation(fields: [optimizationId], references: [id])
  coverLetter   CoverLetter?        @relation(fields: [coverLetterId], references: [id])
  questions     InterviewQuestion[]

  @@index([userId])
  @@index([resumeVariantId])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  order     Int
  category  QuestionCategory

  question    String
  idealAnswer String @map("ideal_answer")
  tips        String

  // "Questions immutable" — no update path exists anywhere in this module;
  // deliberately no updatedAt column, unlike almost every other table in
  // this schema, since a row that can never change doesn't need one.
  createdAt DateTime @default(now()) @map("created_at")

  session InterviewSession @relation(fields: [sessionId], references: [id])
  answer  InterviewAnswer?

  @@index([sessionId])
  @@map("interview_questions")
}

model InterviewAnswer {
  // One answer per question — "Answers editable until evaluation" means
  // resubmitting overwrites this same row (see
  // InterviewRepository.upsertAnswer), never creates a second one.
  id         String @id @default(uuid())
  questionId String @unique @map("question_id")

  answer String

  // Set together, once, by evaluate() — null until then.
  score    Int?
  feedback String?

  strengths    Json
  improvements Json

  // Deliberately no updatedAt column, per the brief's exact field list —
  // upsertAnswer()'s overwrite-in-place behavior is still fully auditable
  // via createdAt plus the parent session's own updatedAt.
  createdAt DateTime @default(now()) @map("created_at")

  question InterviewQuestion @relation(fields: [questionId], references: [id])

  @@map("interview_answers")
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

model Test {
  id        String    @id @default(uuid())
  title     String
  category  String?
  timeLimit Int?      @map("time_limit")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions Question[]
  sessions  TestSession[]

  @@index([category])
  @@map("tests")
}

model Question {
  id            String    @id @default(uuid())
  testId        String    @map("test_id")
  prompt        String
  choices       Json
  correctAnswer String    @map("correct_answer")
  explanation   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  test    Test         @relation(fields: [testId], references: [id])
  answers TestAnswer[]

  @@index([testId])
  @@map("questions")
}

/// One attempt at a test. Retakes allowed — every attempt is its own row,
/// never overwritten. See docs/architecture/database-overview.md §2.
model TestSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  testId        String    @map("test_id")
  attemptNumber Int       @map("attempt_number")
  status        String    @default("IN_PROGRESS")
  score         Int?
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id])
  test    Test         @relation(fields: [testId], references: [id])
  answers TestAnswer[]

  @@unique([userId, testId, attemptNumber])
  @@index([userId, testId])
  @@map("test_sessions")
}

model TestAnswer {
  id             String   @id @default(uuid())
  testSessionId  String   @map("test_session_id")
  questionId     String   @map("question_id")
  selectedAnswer String?  @map("selected_answer")
  isCorrect      Boolean? @map("is_correct")
  createdAt      DateTime @default(now()) @map("created_at")

  session  TestSession @relation(fields: [testSessionId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@index([testSessionId])
  @@map("test_answers")
}

// Interviews: the Phase 0 placeholder `Interview`/`InterviewQuestion` models
// that lived here (schema-only, never implemented — no service/repository/
// controller ever referenced them, exactly like `Cv`/`CvVersion` still
// today) have been removed and superseded by the real, fully-specified
// `InterviewSession`/`InterviewQuestion`/`InterviewAnswer` design above
// (Phase 9) — see docs/architecture/interview-engine.md. This is the one
// pre-existing-schema change this phase required: Prisma forbids two models
// sharing the name `InterviewQuestion`, and the brief's own literal model
// names took precedence over dormant, behavior-free scaffolding.

// ---------------------------------------------------------------------------
// Notifications, History, Audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model HistoryEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  entityRef String?  @map("entity_ref")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("history_events")
}

/// Append-only audit trail. Never deleted through normal application flows.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CV Import Engine (docs/architecture/cv-import.md, Phase 10.5)
// ---------------------------------------------------------------------------

enum CvFileType {
  PDF
  DOCX

  @@map("cv_file_type")
}

enum CvImportStatus {
  PENDING
  EXTRACTED
  CONFIRMED
  DISCARDED
  FAILED

  @@map("cv_import_status")
}

/// "Never automatically save imported data" — this row IS the staging area
/// between upload and confirmation; `extractedData`/`fieldConfidence` are
/// the Preview screen's data source, never written into MasterResume until
/// confirm() explicitly runs. `rawTextExcerpt` deliberately holds only a
/// bounded prefix of the extracted text (not the full document), per
/// docs/architecture/security-architecture.md's PII-minimization spirit —
/// enough for support/debugging, not a second full copy of the user's CV.
model CvImport {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  fileName      String         @map("file_name")
  fileType      CvFileType     @map("file_type")
  fileSizeBytes Int            @map("file_size_bytes")
  status        CvImportStatus @default(PENDING)

  rawTextExcerpt  String? @map("raw_text_excerpt")
  extractedData   Json?   @map("extracted_data")
  fieldConfidence Json?   @map("field_confidence")

  // Snapshot of what CreditService.spendAndExecute() actually charged for
  // the AI Extraction step — 0 until that step runs.
  creditsUsed Int @default(0) @map("credits_used")

  // Set only once confirm() succeeds — the MasterResume this import created.
  masterResumeId String? @map("master_resume_id")
  errorMessage   String? @map("error_message")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  // "Discard" is a soft delete — the row (and its extracted preview) stays
  // available for audit, just hidden from the user's active import list.
  deletedAt DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id])
  masterResume MasterResume? @relation(fields: [masterResumeId], references: [id])

  @@index([userId])
  @@map("cv_imports")
}

// ---------------------------------------------------------------------------
// Template Engine (docs/architecture/template-engine.md, Phase 10.5)
// ---------------------------------------------------------------------------

enum ResumeTemplateCategory {
  ATS_CLASSIC
  MODERN
  EXECUTIVE
  MINIMAL
  CREATIVE
  DEVELOPER
  FINANCE
  MARKETING
  HEALTHCARE
  ACADEMIC
  EUROPASS

  @@map("resume_template_category")
}

enum CoverLetterTemplateCategory {
  PROFESSIONAL
  EXECUTIVE
  MODERN
  CORPORATE
  CREATIVE
  MINIMAL
  ACADEMIC

  @@map("cover_letter_template_category")
}

enum TemplateStatus {
  ACTIVE
  DRAFT
  ARCHIVED

  @@map("template_status")
}

/// "Switch templates... No content duplication. Template changes must be
/// instant" — ResumeVariant/CoverLetter hold a nullable `templateId` FK
/// (see those models); switching is a one-column update, `content` is never
/// touched or copied. `layout` is an open string (e.g. "single-column",
/// "two-column", "sidebar-left") — the brief didn't specify a closed set.
model ResumeTemplate {
  id       String                 @id @default(uuid())
  name     String
  category ResumeTemplateCategory

  previewImage  String? @map("preview_image")
  thumbnail     String?
  isATSFriendly Boolean @default(true) @map("is_ats_friendly")
  premium       Boolean @default(false)
  version       Int     @default(1)

  primaryColor      String   @map("primary_color")
  secondaryColor    String   @map("secondary_color")
  font              String
  layout            String
  supportedSections String[] @map("supported_sections")

  status TemplateStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resumeVariants ResumeVariant[]
  favorites      ResumeTemplateFavorite[]

  @@index([category])
  @@map("resume_templates")
}

model CoverLetterTemplate {
  id       String                      @id @default(uuid())
  name     String
  category CoverLetterTemplateCategory

  previewImage  String? @map("preview_image")
  thumbnail     String?
  isATSFriendly Boolean @default(true) @map("is_ats_friendly")
  premium       Boolean @default(false)
  version       Int     @default(1)

  primaryColor      String   @map("primary_color")
  secondaryColor    String   @map("secondary_color")
  font              String
  layout            String
  supportedSections String[] @map("supported_sections")

  status TemplateStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coverLetters CoverLetter[]
  favorites    CoverLetterTemplateFavorite[]

  @@index([category])
  @@map("cover_letter_templates")
}

/// "Favorite" (Part 7/8 gallery UX). One row per user+template. A real FK to
/// ResumeTemplate (not a polymorphic templateId/templateType pair) — this
/// codebase always models a relation as a concrete typed FK rather than a
/// loosely-typed generic reference (see e.g. Application's separate
/// resumeVariantId/jobTargetId columns), so Resume and Cover Letter
/// favorites are two small, parallel tables rather than one polymorphic one.
/// "Recently used" is deliberately NOT a table here — it's derived from
/// resume_variants.template_id / cover_letters.template_id + updated_at,
/// avoiding a second copy of "which template did this user last touch".
model ResumeTemplateFavorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id])
  template ResumeTemplate @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@index([userId])
  @@map("resume_template_favorites")
}

model CoverLetterTemplateFavorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User                @relation(fields: [userId], references: [id])
  template CoverLetterTemplate @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@index([userId])
  @@map("cover_letter_template_favorites")
}

// ---------------------------------------------------------------------------
// Smart Application Pipeline (docs/architecture/application-pipeline.md, Phase 10.5)
// ---------------------------------------------------------------------------

enum ApplicationPipelineStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED

  @@map("application_pipeline_status")
}

enum ApplicationPipelineStep {
  JOB_IMPORT
  ATS_ANALYSIS
  OPTIMIZATION
  SUGGESTION_REVIEW
  APPLY_SUGGESTIONS
  COVER_LETTER
  INTERVIEW_PREP
  // EXPORT/FINALIZE added in the Smart Application Pipeline implementation
  // pass (checkpoint approved) — the original Phase 10.5 schema stopped at
  // SUMMARY, with no step representing "export the documents" or "register
  // the Application," both explicitly required by this phase's brief.
  EXPORT
  FINALIZE
  SUMMARY

  @@map("application_pipeline_step")
}

/// A guided, resumable "Prepare Application" wizard session — one row per
/// run, `currentStep` tracking progress so the frontend never has to keep
/// wizard state client-side alone (a page refresh mid-wizard doesn't lose
/// place). This module never re-implements ATS/Optimization/Cover
/// Letter/Interview logic — every step delegates to that step's own
/// existing service (AtsAnalysisService, ResumeOptimizationService,
/// CoverLetterService, InterviewService) and just records the resulting
/// entity id here.
///
/// Deliberate schema choice: only `resumeVariantId`/`jobTargetId` (the
/// wizard's required inputs) are true Prisma relations. The step-result
/// pointers (`atsReportId`, `optimizationId`, `newAtsReportId`,
/// `coverLetterId`, `interviewSessionId`, `exportedDocumentId`,
/// `applicationId`) are plain nullable string columns, not `@relation`s —
/// nothing outside this table ever needs to navigate *to* a pipeline
/// session from an AtsReport/CoverLetter/etc., and two columns both
/// pointing at `AtsReport` (before/after) would otherwise need named
/// relations + matching back-relation arrays on a model six other features
/// already depend on. `ApplicationPipelineService` resolves each id through
/// that domain's own service, never raw Prisma joins — see
/// docs/architecture/application-pipeline.md §"Schema".
model ApplicationPipelineSession {
  id              String @id @default(uuid())
  userId          String @map("user_id")
  resumeVariantId String @map("resume_variant_id")
  jobTargetId     String @map("job_target_id")

  atsReportId        String? @map("ats_report_id")
  optimizationId     String? @map("optimization_id")
  newAtsReportId     String? @map("new_ats_report_id")
  coverLetterId      String? @map("cover_letter_id")
  interviewSessionId String? @map("interview_session_id")
  // Added in the implementation pass (checkpoint approved) alongside the
  // EXPORT/FINALIZE steps above — same plain-nullable-string convention as
  // every other step-result pointer on this row.
  exportedDocumentId String? @map("exported_document_id")
  applicationId      String? @map("application_id")

  currentStep ApplicationPipelineStep   @default(JOB_IMPORT) @map("current_step")
  status      ApplicationPipelineStatus @default(IN_PROGRESS)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  deletedAt   DateTime? @map("deleted_at")

  user          User          @relation(fields: [userId], references: [id])
  resumeVariant ResumeVariant @relation(fields: [resumeVariantId], references: [id])
  jobTarget     JobTarget     @relation(fields: [jobTargetId], references: [id])

  @@index([userId])
  @@map("application_pipeline_sessions")
}
