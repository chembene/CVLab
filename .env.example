# CVLab AI - Environment Variable Reference
#
# This file lists every environment variable the platform will eventually need.
# Copy to .env for local development: cp .env.example .env
#
# NEVER commit a real .env file. NEVER put real secrets in this file.
# Phase 0 wired up NODE_ENV / PORT / DATABASE_URL / REDIS_URL / CORS / URLs.
# Phase 1 wires up JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / JWT_ACCESS_TTL /
# JWT_REFRESH_TTL (see docs/architecture/security-architecture.md §1.1).
# OpenAI/R2/M-Pesa remain placeholders reserved for later phases so the
# shape of configuration is stable from day one.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------------
# Port 55432, not 5432 - docker-compose.yml maps the local Postgres container
# to 55432 to avoid colliding with native PostgreSQL processes that may
# already be bound to 5432/5433 on the host machine.
DATABASE_URL="postgresql://cvlab:cvlab_dev_password@localhost:55432/cvlab_ai?schema=public"

# ---------------------------------------------------------------------------
# Cache (Redis)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Authentication (JWT + Refresh Tokens) - wired up as of Phase 1.
# JWT_ACCESS_SECRET signs/verifies short-lived access tokens.
# JWT_REFRESH_SECRET is an HMAC pepper for hashing opaque refresh/
# verification/reset tokens before persistence (never signs a JWT).
# Both are validated at startup (min 32 chars) - see src/config/env.validation.ts.
# Generate real values with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=changeme_access_secret_placeholder_do_not_use_in_prod
JWT_REFRESH_SECRET=changeme_refresh_secret_placeholder_do_not_use_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# AI (OpenAI API) - reserved for Phase 6, not wired up yet
# ---------------------------------------------------------------------------
OPENAI_API_KEY=changeme_openai_api_key_placeholder

# ---------------------------------------------------------------------------
# Object Storage (Cloudflare R2) - reserved for Phase 5, not wired up yet
# ---------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=changeme_r2_account_id_placeholder
CLOUDFLARE_R2_ACCESS_KEY_ID=changeme_r2_access_key_id_placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=changeme_r2_secret_access_key_placeholder
CLOUDFLARE_R2_BUCKET_NAME=changeme_r2_bucket_name_placeholder

# ---------------------------------------------------------------------------
# Payments (M-Pesa) - reserved for Phase 4, not wired up yet.
# Exact variable names are placeholders only; MUST be verified against the
# official M-Pesa developer portal (https://developer.mpesa.vm.co.mz/) before
# real implementation. Do not invent endpoint/credential shapes beyond this.
# ---------------------------------------------------------------------------
MPESA_API_BASE_URL=changeme_mpesa_api_base_url_placeholder
MPESA_CONSUMER_KEY=changeme_mpesa_consumer_key_placeholder
MPESA_CONSUMER_SECRET=changeme_mpesa_consumer_secret_placeholder
MPESA_PUBLIC_KEY=changeme_mpesa_public_key_placeholder
MPESA_SERVICE_PROVIDER_CODE=changeme_mpesa_service_provider_code_placeholder

# ---------------------------------------------------------------------------
# Cross-service URLs / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Client-side (Next.js inlines NEXT_PUBLIC_* at build time). Added in Phase 1
# now that apps/web actually calls the API. Defaults to http://localhost:4000
# in code if unset, so this is only needed to override that default — see
# apps/web/lib/api-client.ts. To set it for apps/web specifically, create
# apps/web/.env.local (gitignored) rather than editing this root file.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
